include_guard(GLOBAL)
# Capture at include time, not at function call time. The latter may be in a
# different directory. CMAKE_CURRENT_FUNCTION_LIST_DIR requires CMake 3.17;
# a global property preserves this path using the declared CMake 3.13 baseline.
get_filename_component(_PICOW_SPP_OVERLAY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set_property(GLOBAL PROPERTY PICOW_SPP_OVERLAY_ROOT "${_PICOW_SPP_OVERLAY_ROOT}")

# Generate reviewed sources into this build only. A consumer property chooses
# the overlays, so unrelated applications sharing the SDK targets stay pristine.
function(picow_enable_spp_sdk_overlay target)
  get_property(PICOW_SPP_OVERLAY_ROOT GLOBAL PROPERTY PICOW_SPP_OVERLAY_ROOT)
  get_property(prepared GLOBAL PROPERTY PICOW_SPP_OVERLAY_PREPARED)
  if(NOT prepared)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(generated "${CMAKE_BINARY_DIR}/picow_spp_btstack_overlay")
    foreach(kind l2cap rfcomm)
      if(kind STREQUAL "l2cap")
        set(owner pico_btstack_base)
        set(relative src/l2cap.c)
      else()
        set(owner pico_btstack_classic)
        set(relative src/classic/rfcomm.c)
      endif()
      set(original "${PICO_BTSTACK_PATH}/${relative}")
      if(NOT EXISTS "${original}")
        set(original "${PICO_SDK_PATH}/lib/btstack/${relative}")
      endif()
      set(output "${generated}/${kind}.c")
      execute_process(COMMAND "${Python3_EXECUTABLE}" "${PICOW_SPP_OVERLAY_ROOT}/tools/patch_spp_ertm_sdk.py" "${kind}" "${original}" "${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "SPP ${kind} overlay generation failed: ${stdout}${stderr}")
      endif()
      get_target_property(sources ${owner} INTERFACE_SOURCES)
      list(FIND sources "${original}" index)
      if(index EQUAL -1)
        message(FATAL_ERROR "SDK SPP source layout changed: ${original} is not a direct ${owner} source")
      endif()
      list(REMOVE_AT sources ${index})
      list(APPEND sources "$<IF:$<BOOL:$<TARGET_PROPERTY:PICOW_SPP_SDK_OVERLAY>>,${output},${original}>")
      set_property(TARGET ${owner} PROPERTY INTERFACE_SOURCES "${sources}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${PICOW_SPP_OVERLAY_ROOT}/tools/patch_spp_ertm_sdk.py")
    endforeach()
    set_property(GLOBAL PROPERTY PICOW_SPP_OVERLAY_PREPARED TRUE)
  endif()
  set_property(TARGET ${target} PROPERTY PICOW_SPP_SDK_OVERLAY TRUE)
  target_compile_definitions(${target} PRIVATE PICOW_SPP_SDK_OVERLAY=1)
endfunction()
