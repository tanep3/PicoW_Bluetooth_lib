include_guard(GLOBAL)
get_filename_component(PICOW_AVRCP_OVERLAY_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
# Keep the definition path available to calls from other directory/function scopes.
set_property(GLOBAL PROPERTY PICOW_AVRCP_OVERLAY_ROOT "${PICOW_AVRCP_OVERLAY_ROOT}")
# Per-consumer source selection: never edit installed SDK files or force other
# executables linked to pico_btstack_classic to use this overlay.
function(picow_enable_avrcp_sdk_overlay target)
  get_property(PICOW_AVRCP_OVERLAY_ROOT GLOBAL PROPERTY PICOW_AVRCP_OVERLAY_ROOT)
  get_property(prepared GLOBAL PROPERTY PICOW_AVRCP_OVERLAY_PREPARED)
  if(NOT prepared)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(generated "${CMAKE_BINARY_DIR}/picow_btstack_overlay")
    get_target_property(sources pico_btstack_classic INTERFACE_SOURCES)
    foreach(role common target controller)
      if(role STREQUAL "common")
        set(source_name "avrcp.c")
      else()
        set(source_name "avrcp_${role}.c")
      endif()
      set(original "${PICO_BTSTACK_PATH}/src/classic/${source_name}")
      if(NOT EXISTS "${original}")
        set(original "${PICO_SDK_PATH}/lib/btstack/src/classic/${source_name}")
      endif()
      set(output "${generated}/${source_name}")
      execute_process(COMMAND "${Python3_EXECUTABLE}" "${PICOW_AVRCP_OVERLAY_ROOT}/tools/patch_avrcp_${role}.py" "${original}" "${output}"
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "AVRCP ${role} overlay generation failed: ${stdout}${stderr}")
      endif()
      list(FIND sources "${original}" index)
      if(index EQUAL -1)
        message(FATAL_ERROR "SDK AVRCP source layout changed: ${original} is not a direct classic source")
      endif()
      list(REMOVE_AT sources ${index})
      list(APPEND sources "$<IF:$<BOOL:$<TARGET_PROPERTY:PICOW_AVRCP_SDK_OVERLAY>>,${output},${original}>")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${PICOW_AVRCP_OVERLAY_ROOT}/tools/patch_avrcp_${role}.py")
    endforeach()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PICOW_AVRCP_OVERLAY_ROOT}/tools/avrcp_controller_fragments.py" "${PICOW_AVRCP_OVERLAY_ROOT}/tools/avrcp_controller_custom.py" "${PICOW_AVRCP_OVERLAY_ROOT}/tools/avrcp_target_metadata_patch.py")
    set_property(TARGET pico_btstack_classic PROPERTY INTERFACE_SOURCES "${sources}")
    set_property(GLOBAL PROPERTY PICOW_AVRCP_OVERLAY_PREPARED TRUE)
  endif()
  set_property(TARGET ${target} PROPERTY PICOW_AVRCP_SDK_OVERLAY TRUE)
  target_compile_definitions(${target} PRIVATE PICOW_AVRCP_SDK_OVERLAY=1)
endfunction()
