# Call after pico_sdk_init(). Explicit geometry is required, in bytes.
include_guard(GLOBAL)
get_filename_component(_persistent_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set_property(GLOBAL PROPERTY PICOW_PERSISTENT_BONDS_ROOT "${_persistent_root}")
function(picow_enable_persistent_bonds target storage_offset total_size)
    if(NOT ARGC EQUAL 3)
        message(FATAL_ERROR "Provide target, reviewed flash storage offset and total two-bank size")
    endif()
    get_target_property(target_type ${target} TYPE)
    if(NOT target_type STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "Persistent bonds must be configured on the final executable target")
    endif()
    foreach(value IN ITEMS "${storage_offset}" "${total_size}")
        if(NOT value MATCHES "^(0[xX][0-9a-fA-F]+|[0-9]+)$")
            message(FATAL_ERROR "Persistent bond geometry must be integer byte values")
        endif()
    endforeach()
    get_property(root GLOBAL PROPERTY PICOW_PERSISTENT_BONDS_ROOT)
    # Narrowly pinned integration: do not silently use unsafe upstream startup.
    if(NOT PICO_SDK_VERSION_STRING STREQUAL "2.1.1" OR NOT PICO_BOARD STREQUAL "pico_w")
        message(FATAL_ERROR "Committed TLV currently supports only reviewed Pico SDK 2.1.1 / pico_w")
    endif()
    if(NOT TARGET pico_btstack_cyw43)
        message(FATAL_ERROR "The source-based SDK CYW43 target is required")
    endif()
    math(EXPR bank_size "${total_size} / 2")
    if(bank_size LESS 4096 OR bank_size GREATER 16384)
        message(FATAL_ERROR "Committed TLV supports 4096..16384-byte banks only")
    endif()
    set(startup "${PICO_SDK_PATH}/src/rp2_common/pico_cyw43_driver/btstack_cyw43.c")
    set(hal "${PICO_SDK_PATH}/src/rp2_common/pico_btstack/btstack_flash_bank.c")
    set(journal "${PICO_BTSTACK_PATH}/platform/embedded/btstack_tlv_flash_bank.c")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${startup}" "${hal}" "${journal}")
    file(SHA256 "${startup}" startup_hash)
    file(SHA256 "${hal}" hal_hash)
    file(SHA256 "${journal}" journal_hash)
    if(NOT startup_hash STREQUAL "99753d0e0fb9ace87d4ef64b98e6f82bd401c251d4f7b70c060b5fa8e15f7a90" OR
       NOT hal_hash STREQUAL "017d5ddb1641d989b07a77117d396f94b428bbf87397afb6fb716975b87333ec" OR
       NOT journal_hash STREQUAL "650975968466efd3f5cd2e17e81e42c3cebf2e0ad85bd6f622c881f549cc9692")
        message(FATAL_ERROR "Unsupported SDK storage sources: review and repin before use")
    endif()
    get_property(patched GLOBAL PROPERTY PICOW_COMMITTED_TLV_OVERLAY)
    if(NOT patched)
        get_target_property(startup_sources pico_btstack_cyw43 INTERFACE_SOURCES)
        list(FIND startup_sources "${startup}" source_index)
        if(source_index LESS 0)
            message(FATAL_ERROR "Unsupported CYW43 source layout/precompiled initialization")
        endif()
        set(overlay "${CMAKE_BINARY_DIR}/picow_committed_btstack_cyw43.c")
        file(READ "${startup}" startup_text)
        string(REPLACE "#include \"btstack_tlv_flash_bank.h\"" "#include \"PicoCommittedTlv.h\"" startup_text "${startup_text}")
        string(REPLACE "static btstack_tlv_flash_bank_t btstack_tlv_flash_bank_context;" "static unsigned char btstack_tlv_flash_bank_context;" startup_text "${startup_text}")
        string(REPLACE "btstack_tlv_flash_bank_init_instance(\n            &btstack_tlv_flash_bank_context,\n            hal_flash_bank_impl,\n            NULL)" "picow_committed_tlv_init(hal_flash_bank_impl, NULL)" startup_text "${startup_text}")
        # No journal initialization symbol may remain in generated startup.
        if(startup_text MATCHES "btstack_tlv_flash_bank_init_instance")
            message(FATAL_ERROR "Failed to replace unsafe initialization")
        endif()
        file(WRITE "${overlay}" "${startup_text}")
        list(REMOVE_AT startup_sources ${source_index})
        list(APPEND startup_sources
            "$<$<BOOL:$<TARGET_PROPERTY:PICOW_COMMITTED_TLV>>:${overlay}>"
            "$<$<NOT:$<BOOL:$<TARGET_PROPERTY:PICOW_COMMITTED_TLV>>>:${startup}>")
        set_property(TARGET pico_btstack_cyw43 PROPERTY INTERFACE_SOURCES "${startup_sources}")
        set_property(GLOBAL PROPERTY PICOW_COMMITTED_TLV_OVERLAY "${overlay}")
    endif()
    set_property(TARGET ${target} PROPERTY PICOW_COMMITTED_TLV TRUE)
    target_compile_definitions(${target} PRIVATE PICOW_TLV_BANK_SIZE=${bank_size} PICOW_COMMITTED_TLV_PROVIDER=1)
    target_sources(${target} PRIVATE "${root}/bluetooth-runtime/PicoCommittedTlv.cpp")
    target_sources(${target} PRIVATE "${root}/bluetooth-runtime/PicoPersistentBonds.cpp"
        "${root}/bluetooth-runtime/PicoPersistentBondsPicoGuard.cpp")
    target_compile_features(${target} PRIVATE cxx_std_17)
    target_include_directories(${target} PRIVATE "${root}/bluetooth-runtime")
    target_compile_definitions(${target} PRIVATE
        PICO_FLASH_BANK_STORAGE_OFFSET=${storage_offset}
        PICO_FLASH_BANK_TOTAL_SIZE=${total_size}
        PICOW_BOND_EXPECTED_OFFSET=${storage_offset}
        PICOW_BOND_EXPECTED_TOTAL=${total_size})
    # Unconditional, including Release builds. This protects the linked image,
    # not an external filesystem/OTA layout, bootloader, or other flash users.
    set(guard "${CMAKE_CURRENT_BINARY_DIR}/${target}_bond_flash_guard.ld")
    file(WRITE "${guard}" "ASSERT(__flash_binary_end <= (0x10000000 + ${storage_offset}), \"persistent bond banks overlap firmware\")\n")
    target_link_options(${target} PRIVATE "LINKER:-T,${guard}")
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${guard}")
endfunction()
