include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/picow_avrcp_controller.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/picow_spp_sdk_overlay.cmake)
function(picow_target_avrcp_browsing target config_directory)
  get_property(PICOW_AVRCP_ROOT GLOBAL PROPERTY PICOW_AVRCP_ROOT)
  picow_target_avrcp_controller(${target} ${config_directory})
  picow_enable_spp_sdk_overlay(${target})
  get_property(prepared GLOBAL PROPERTY PICOW_BROWSING_PREPARED)
  if(NOT prepared)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    foreach(role browsing browsing_controller)
    set(original "${PICO_SDK_PATH}/lib/btstack/src/classic/avrcp_${role}.c")
    set(output "${CMAKE_BINARY_DIR}/picow_btstack_overlay/avrcp_${role}.c")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${PICOW_AVRCP_ROOT}/tools/patch_avrcp_${role}.py" "${original}" "${output}" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Browsing overlay generation failed")
    endif()
    get_target_property(sources pico_btstack_classic INTERFACE_SOURCES)
    list(FIND sources "${original}" index)
    if(index EQUAL -1)
      message(FATAL_ERROR "Browsing SDK source layout changed")
    endif()
    list(REMOVE_AT sources ${index})
    list(APPEND sources "$<IF:$<BOOL:$<TARGET_PROPERTY:PICOW_AVRCP_BROWSING>>,${output},${original}>")
    set_property(TARGET pico_btstack_classic PROPERTY INTERFACE_SOURCES "${sources}")
    set_property(GLOBAL PROPERTY PICOW_BROWSING_PREPARED TRUE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${PICOW_AVRCP_ROOT}/tools/patch_avrcp_${role}.py")
    endforeach()
  endif()
  set_property(TARGET ${target} PROPERTY PICOW_AVRCP_BROWSING TRUE)
  target_compile_definitions(${target} PRIVATE PICOW_AVRCP_BROWSING=1)
  target_sources(${target} PRIVATE ${PICOW_AVRCP_ROOT}/avrcp-sdk/AvrcpBrowsingController.cpp)
endfunction()
