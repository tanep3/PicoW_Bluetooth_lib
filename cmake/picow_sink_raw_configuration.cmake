include_guard(GLOBAL)
get_filename_component(PICOW_SINK_RAW_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set_property(GLOBAL PROPERTY PICOW_SINK_RAW_ROOT "${PICOW_SINK_RAW_ROOT}")
function(picow_enable_sink_raw_configuration target)
  get_property(root GLOBAL PROPERTY PICOW_SINK_RAW_ROOT)
  get_property(prepared GLOBAL PROPERTY PICOW_SINK_RAW_PREPARED)
  if(NOT prepared)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    set(original "${PICO_BTSTACK_PATH}/src/classic/avdtp_acceptor.c")
    if(NOT EXISTS "${original}")
      set(original "${PICO_SDK_PATH}/lib/btstack/src/classic/avdtp_acceptor.c")
    endif()
    get_target_property(sources pico_btstack_classic INTERFACE_SOURCES)
    list(FIND sources "${original}" index)
    if(index EQUAL -1)
      message(FATAL_ERROR "Sink raw guard requires direct SDK avdtp_acceptor.c; conflicting AVDTP overlay or SDK layout")
    endif()
    set(output "${CMAKE_BINARY_DIR}/picow_sink_raw_configuration/avdtp_acceptor.c")
    execute_process(COMMAND "${Python3_EXECUTABLE}" "${root}/tools/patch_sink_raw_configuration.py" "${original}" "${output}"
      RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Sink raw guard generation failed: ${stdout}${stderr}")
    endif()
    list(REMOVE_AT sources ${index})
    list(APPEND sources "$<IF:$<BOOL:$<TARGET_PROPERTY:PICOW_SINK_RAW_CONFIGURATION>>,${output},${original}>")
    set_property(TARGET pico_btstack_classic PROPERTY INTERFACE_SOURCES "${sources}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${root}/tools/patch_sink_raw_configuration.py")
    set_property(GLOBAL PROPERTY PICOW_SINK_RAW_PREPARED TRUE)
  endif()
  set_property(TARGET ${target} PROPERTY PICOW_SINK_RAW_CONFIGURATION TRUE)
endfunction()
