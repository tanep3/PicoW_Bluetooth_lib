include_guard(GLOBAL)
include(${CMAKE_CURRENT_LIST_DIR}/picow_avrcp_controller.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/picow_spp_sdk_overlay.cmake)
function(picow_target_avrcp_cover_art target config_directory)
  get_property(PICOW_AVRCP_ROOT GLOBAL PROPERTY PICOW_AVRCP_ROOT)
  picow_target_avrcp_controller(${target} ${config_directory})
  picow_enable_spp_sdk_overlay(${target})
  get_property(prepared GLOBAL PROPERTY PICOW_COVER_ART_PREPARED)
  if(NOT prepared)
    find_package(Python3 REQUIRED COMPONENTS Interpreter)
    foreach(role avrcp_cover_art_client goep_client)
      if(role STREQUAL "avrcp_cover_art_client")
        set(script "${PICOW_AVRCP_ROOT}/tools/patch_avrcp_cover_art.py")
      else()
        set(script "${PICOW_AVRCP_ROOT}/tools/patch_goep_client.py")
      endif()
      set(original "${PICO_SDK_PATH}/lib/btstack/src/classic/${role}.c")
      set(output "${CMAKE_BINARY_DIR}/picow_cover_art_overlay/${role}.c")
      execute_process(COMMAND "${Python3_EXECUTABLE}" "${script}" "${original}" "${output}" RESULT_VARIABLE result)
      if(NOT result EQUAL 0)
        message(FATAL_ERROR "Cover Art ${role} overlay generation failed")
      endif()
      get_target_property(sources pico_btstack_classic INTERFACE_SOURCES)
      list(FIND sources "${original}" index)
      if(index EQUAL -1)
        message(FATAL_ERROR "Cover Art SDK source layout changed")
      endif()
      list(REMOVE_AT sources ${index})
      list(APPEND sources "$<IF:$<BOOL:$<TARGET_PROPERTY:PICOW_AVRCP_COVER_ART>>,${output},${original}>")
      set_property(TARGET pico_btstack_classic PROPERTY INTERFACE_SOURCES "${sources}")
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}" "${script}")
    endforeach()
    set_property(GLOBAL PROPERTY PICOW_COVER_ART_PREPARED TRUE)
  endif()
  set_property(TARGET ${target} PROPERTY PICOW_AVRCP_COVER_ART TRUE)
  target_compile_definitions(${target} PRIVATE PICOW_AVRCP_COVER_ART=1)
  target_sources(${target} PRIVATE ${PICOW_AVRCP_ROOT}/avrcp-sdk/AvrcpCoverArt.cpp)
endfunction()
